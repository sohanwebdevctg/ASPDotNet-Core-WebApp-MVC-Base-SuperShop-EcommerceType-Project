@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    <!-- Getting UserId & UserRole from session -->
    var userId = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");
    var userRole = HttpContextAccessor.HttpContext.Session.GetInt32("UserRole");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuperShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" />
    <link rel="stylesheet" href="~/css/desktop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuperShop.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- desktop header start -->
    <header class="desktop-header">
        <nav class="desktop-nav">
            <div class="logo">
                <a href="@Url.Action("Index","Admin")"><img src="@Url.Content("~/images/logo/SuperShopLogo.png")" /></a>
            </div>
            <div class="nav-controls">
                <button id="openBtn"><i class="fa-solid fa-bars openIcon"></i></button>
                <button id="closeBtn" style="display: none;"><i class="fa-solid fa-xmark closeIcon"></i></button>
            </div>
        </nav>
        <div id="sideBar" class="sidebar-hidden">
            <div class="sidebar-content">
                <ul class="nav-links">
                    <li><a href="@Url.Action("Index","Admin")">All Users</a></li>
                    <li><a href="@Url.Action("ManageOrders","Admin")">Manage Orders</a></li>
                    <li><a href="@Url.Action("PaymentHistory","Admin")">Payment History</a></li>
                    <li><a href="@Url.Action("CreateBanner","Admin")">Create Banner</a></li>
                    <li><a href="@Url.Action("CreateOffer","Admin")">Create Offer</a></li>
                    <li><a href="@Url.Action("Contact","Admin")">Contact</a></li>
                    <li><a href="@Url.Action("CreateGender","Admin")">Create Gender</a></li>
                    <li><a href="@Url.Action("CreateCity","Admin")">Create City</a></li>
                    <li><a href="@Url.Action("CreateCountry","Admin")">Create Country</a></li>
                    <li><a href="@Url.Action("CreateRole","Admin")">Create Role</a></li>
                    <li><a href="@Url.Action("CreateCategory","Admin")">Create Category</a></li>
                    <li><a href="@Url.Action("CreateProduct","Admin")">Create Product</a></li>
                </ul>
                @if (userId != null && userRole == 1 ){
                <div class="sidebar-footer">
                    <ul class="admin-actions">
                        <li>
                            <a href="@Url.Action("Order","Admin")"><i class="fa-solid fa-cart-shopping cartIcon"></i></a>
                            <a href="@Url.Action("AdminProfile","Admin")"><i class="fa-solid fa-user-tie userIcon"></i></a>
                        </li>
                            <li>
                                <form asp-controller="Login" asp-action="LogOut" method="post" style="display:inline;">
                                    <button type="submit" class="text-white">Logout</button>
                                </form>
                            </li>
                    </ul>
                </div>
                }
            </div>
        </div>
    </header>
    <!-- desktop heder end -->
    <div>
        <main>
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/all.min.js"></script>
    <script src="~/js/desktop.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
