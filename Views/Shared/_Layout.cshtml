<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuperShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuperShop.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- mobile-header -->
    <header class="mobile-header">
        <nav class="mobile-nav">
            <div class="logo">
                <a href="@Url.Action("Index","Customer")"><img src="@Url.Content("~/images/logo/SuperShopLogo.png")" /></a>
            </div>
            <div class="nav-controls">
                <button id="openBtn"><i class="fa-solid fa-bars openIcon"></i></button>
                <button id="closeBtn" style="display: none;"><i class="fa-solid fa-xmark closeIcon"></i></button>
            </div>
        </nav>
        <div id="sideBar" class="sidebar-hidden">
            <div class="sidebar-content">
                <ul class="nav-links">
                    <li><a href="@Url.Action("Index","Customer")">Home</a></li>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Product</a></li>
                    <li><a href="#">Contact</a></li>
                    <li><a href="@Url.Action("Blog","Customer")">Blog</a></li>
                </ul>
                <div class="sidebar-footer">
                    <ul class="user-actions">
                        <li>
                            <a href="#"><i class="fa-solid fa-cart-shopping cartIcon"></i></a>
                            <a href="#"><i class="fa-solid fa-user-tie userIcon"></i></a>
                        </li>
                        <li><button class="auth-btn"><a href="#">Logout</a></button></li>
                        <li><button class="auth-btn"><a href="#">Login</a></button></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- desktop-header -->
    <header class="desktop-header">
        <div class="myContainer">
            <nav>
                <div class="logo">
                    <a href="@Url.Action("Index","Customer")"><img src="@Url.Content("~/images/logo/SuperShopLogo.png")" /></a>
                </div>
                <div>
                    <ul>
                        <li><a href="@Url.Action("Index","Customer")">Home</a></li>
                        <li><a href="#">About</a></li>
                        <li><a href="#">Product</a></li>
                        <li><a href="#">Contact</a></li>
                        <li><a href="@Url.Action("Blog","Customer")">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <button><a href="#">Login</a></button>
                    @*<a href="#"><i class="fa-solid fa-cart-shopping cartIcon"></i></a>
                    <a href="#"><i class="fa-solid fa-user-tie userIcon"></i></a>
                    <button><a href="#">logout</a></button>*@
                </div>
            </nav>
        </div>
    </header>
    
    <!-- main container-->
    <div class="myContainer">
        <main>
            @RenderBody()
        </main>
    </div>

    <!-- footer section -->
    <footer class="site-footer">
        <div class="myContainer">
            <div class="footer-top-grid">
                <div class="footer-col">
                    <h3>Useful Links</h3>
                    <ul>
                        <li><a href="#">Home</a></li>
                        <li><a href="#">Shop Product</a></li>
                        <li><a href="#">Latest Blog</a></li>
                        <li><a href="#">Flash Sale</a></li>
                        <li><a href="#">Our Story</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h3>Categories</h3>
                    <ul>
                        <li><a href="#">Electronics</a></li>
                        <li><a href="#">Fashion Wear</a></li>
                        <li><a href="#">Home Appliances</a></li>
                        <li><a href="#">Health & Beauty</a></li>
                        <li><a href="#">Gadgets Shop</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h3>Customer Service</h3>
                    <ul>
                        <li><a href="#">Contact Support</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms & Conditions</a></li>
                        <li><a href="#">Return & Refund</a></li>
                        <li><a href="#">Shipping Info</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h3>My Account</h3>
                    <ul>
                        <li><a href="#">User Profile</a></li>
                        <li><a href="#">Order History</a></li>
                        <li><a href="#">My Wishlist</a></li>
                        <li><a href="#">Shopping Cart</a></li>
                        <li><a href="#">Track My Order</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="copyright">
                    <p>&copy; 2026 SuperShop. All Rights Reserved.</p>
                </div>
                <div class="payment-methods">
                    <img src="@Url.Content("~/images/logo/visalogo.png")" alt="Payments" />
                    <img src="@Url.Content("~/images/logo/discoverlogo.png")" alt="Payments" />
                    <img src="@Url.Content("~/images/logo/masterlogo.png")" alt="Payments" />
                    <img src="@Url.Content("~/images/logo/americanlogo.png")" alt="Payments" />
                   
                </div>
            </div>
        </div>
    </footer>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
