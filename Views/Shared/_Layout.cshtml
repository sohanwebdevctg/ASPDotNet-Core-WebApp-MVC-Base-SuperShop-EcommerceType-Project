<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuperShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuperShop.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- mobile-header -->
    <header class="mobile-header">
        <nav>
            <div class="logo">
                <a href="#"><img src="@Url.Content("~/images/logo/SuperShopLogo.png")" /></a>
            </div>
            <div>
                <button><i class="fa-solid fa-bars openIcon"></i></button>
                <button><i class="fa-solid fa-xmark closeIcon"></i></button>
            </div>
        </nav>
    </header>

    <!-- desktop-header -->
    <header class="desktop-header">
        <div class="myContainer">
            <nav>
                <div class="logo">
                    <a href="#"><img src="@Url.Content("~/images/logo/SuperShopLogo.png")"/></a>
                </div>
                <div>
                    <ul>
                        <li><a href="#">Home</a></li>
                        <li><a href="#">About</a></li>
                        <li><a href="#">Product</a></li>
                        <li><a href="#">Contact</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <button><a href="#">Login</a></button>
                    @*<a href="#"><i class="fa-solid fa-cart-shopping cartIcon"></i></a>
                    <a href="#"><i class="fa-solid fa-user-tie userIcon"></i></a>
                    <button><a href="#">logout</a></button>*@
                </div>
            </nav>
        </div>
    </header>
    

    <div class="container">
        <main>
           
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
