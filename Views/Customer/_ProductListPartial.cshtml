@model IEnumerable<SuperShop.Models.Product>

@foreach (var data in Model)
{
    <div class="product-card">
        <div class="product-img-container">
            <img src="~/images/product_img/@data.ProductImage" alt="@data.ProductName">
        </div>

        <div class="product-body">
            <h5 class="product-title">@data.ProductName</h5>
            <p class="product-price">Price: $@data.ProductPrice.ToString("F2")</p>
            <p class="product-desc">
                <strong>ProductLimit :</strong>
                @(data.ProductLimit < 0 ? 0 : data.ProductLimit)
            </p>
            <p class="product-desc">
                @(data.ProductDescription?.Length > 30 ? data.ProductDescription.Substring(0, 30) + "..." : data.ProductDescription)
            </p>

            <div>
                <a href="@Url.Action("ProductDetails", "Customer", new { id = data.ProductId })" class="cart-btn">
                    View Details
                </a>
            </div>
        </div>
    </div>
}