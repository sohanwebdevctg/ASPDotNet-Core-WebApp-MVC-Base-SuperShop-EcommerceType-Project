
@{
    ViewData["Title"] = "Blog";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- blog start -->

<div class="blog-section">
    <div class="myContainer">
        <div class="blog-grid">
            <div class="blog-card">
                <div class="blog-img">
                    <img src="/images/blog_img/blog1.jpg" alt="Blog Image">
                </div>
                <div class="blog-info">
                    <h3>Latest Product Trends</h3>
                    <p>Explore the most popular electronics and gadgets that are currently dominating the market with innovative technology and unique features today.</p>
                    <p>Our experts provide deep analysis on future tech trends to help you stay ahead and choose the perfect devices for your modern lifestyle and home.</p>
                </div>
                </div>

            <div class="blog-card">
                <div class="blog-img">
                    <img src="/images/blog_img/blog2.jpg" alt="Blog Image">
                </div>
                <div class="blog-info">
                    <h3>Summer Fashion Guide</h3>
                <p>Stay cool and incredibly stylish with our exclusive new collection of premium summer wear designed specifically for both men and women this season.</p>
                <p>Learn how to mix and match different fabrics and vibrant colors to create a fresh look that keeps you comfortable even in the hottest summer weather.</p>
                </div>
            </div>

            <div class="blog-card">
                <div class="blog-img">
                    <img src="/images/blog_img/blog3.png" alt="Blog Image">
                </div>
                <div class="blog-info">
                    <h3>How to Shop Smart</h3>
                <p>Discover the best insider tips and tricks on how to find massive deals and seasonal discounts on all your favorite shopping items quite easily.</p>
                <p>We offer a comprehensive step-by-step guide to secure online shopping experiences while saving a significant amount of money on every purchase made.</p>
            </div>
        </div>
        </div>
    </div>
</div>

<!-- blog end -->