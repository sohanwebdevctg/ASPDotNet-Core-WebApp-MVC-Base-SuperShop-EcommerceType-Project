@model SuperShop.Models.Contact;
@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- contact section start -->
<div class="contact-section">
    <div class="myContainer">
        <div class="contact-wrapper">
            <div class="contact-form-container">
                @if (TempData["Error"] != null)
                {
                <div class="alert" style="color: red; font-weight: bold; margin-bottom: 5px;">
                    @TempData["Error"]
                </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert" style="color: green; font-weight: bold; margin-bottom: 5px;">
                        @TempData["Success"]
                    </div>
                }
                <form asp-controller="Customer" asp-action="Contact" method="post" class="contact-form">
                    <div class="input-box">
                        <input asp-for="UserName" value="@ViewBag.userName" type="text" placeholder="Enter Your Name" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="input-box">
                        <input asp-for="UserEmail" value="@ViewBag.userEmail" type="email" placeholder="Enter Your Email" />
                        <span asp-validation-for="UserEmail" class="text-danger"></span>
                    </div>
                    <div class="input-box">
                        <textarea asp-for="UserMessage" placeholder="Enter your Message"></textarea>
                        <span asp-validation-for="UserMessage" class="text-danger"></span>
                    </div>
                    <div class="submit-box">
                        <input type="submit" value="Send Message" class="contact-submit" />
                    </div>
                </form>
                
            </div>

            <div class="contact-map">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3651.902442430139!2d90.3910801!3d23.7508671!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755b898376dbc5d%3A0x67629a6401a51!2sDhaka!5e0!3m2!1sen!2sbd!4v1715600000000!5m2!1sen!2sbd" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</div>
<!-- contact section start -->

