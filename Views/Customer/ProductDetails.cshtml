@model SuperShop.Models.Product;
@{
    ViewData["Title"] = "ProductDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- product details start -->
<div class="myContainer">
    <div class="userprofile-section">
        <div class="userprofile-wrapper">
            <div class="userprofile-img">
                <img src="@Url.Content(Model.ProductImage != null ? "~/images/product_img/"+Model.ProductImage : "~/images/product_img/no-user.png")" alt="User Name" asp-append-version=true>
            </div>

            <div class="userprofile-content">
                <h4 class="userprofile-title">Product Details</h4>
                <h3 class="userprofiel-name">@(Model.ProductName != null ? Model.ProductName : "No Data")</h3>
                <div class="userprofile-role">Category: @(Model.Category?.CategoryName != null ? Model.Category?.CategoryName : "No Data")</div>
                <p class="userprofile-desc"><strong>Price: </strong>$@Model.ProductPrice.ToString("F2")</p>
                <p class="userprofile-desc"><strong>Stock Limit: </strong>@Model.ProductLimit</p>

                <p class="userprofile-desc" style="margin-top: 10px;">
                    <strong>Description: </strong> @Model.ProductDescription
                </p>
                 <form asp-action="BuyNow" asp-controller="Customer" method="post">
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <div class="userprofile-actions">
                            <button type="submit" class="buttons" style="border:none; cursor:pointer; background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">
                                Buy Now
                            </button>
                        <a href="@Url.Action("AllProducts", "Customer")" class="buttons" style="text-decoration:none; background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Back</a>
                    </div>
                 </form>
            </div>
        </div>
    </div>
</div>
<!-- product details end -->
