@model SuperShop.ViewModels.HomeVM
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- banner section start -->

<div class="myContainer">
    <div class="banner-grid">
        @if (Model.Banners != null && Model.Banners.Any())
        {
            var banners = Model.Banners.ToList();

            <div class="main-banner" style="background-image: url('/images/banner_img/@banners[0].BannerImage');">
                <div class="banner-content">
                    <p>@banners[0].BannerType</p>
                    <h1>@banners[0].BannerName</h1>
                    <button class="banner-btn">SHOP NOW &rarr;</button>
                </div>
            </div>

            <div class="side-banners">
                @if (banners.Count > 1)
                {
                    <div class="top-banner" style="background-image: url('/images/banner_img/@banners[1].BannerImage');">
                        <div class="banner-content small">
                            <p>@banners[1].BannerType</p>
                            <h2>@banners[1].BannerName</h2>
                            <button class="banner-btn">BUY NOW &rarr;</button>
                        </div>
                    </div>
                }
                @if (banners.Count > 2)
                {
                    <div class="bottom-banner" style="background-image: url('/images/banner_img/@banners[2].BannerImage');">
                        <div class="banner-content small">
                            <p>@banners[2].BannerType</p>
                            <h2>@banners[2].BannerName</h2>
                            <button class="banner-btn">BUY NOW &rarr;</button>
                        </div>
                    </div>
                }
                
            </div>

        }
        
    </div>
</div>

<!-- banner section end -->
