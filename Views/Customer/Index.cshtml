@model SuperShop.ViewModels.HomeVM
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- banner section start -->

<div class="myContainer">
    <div class="banner-grid">
        @if (Model.Banners != null && Model.Banners.Any())
        {
            var banners = Model.Banners.ToList();

            <div class="main-banner" style="background-image: url('/images/banner_img/@banners[0].BannerImage');">
                <div class="banner-content">
                    <p>@banners[0].BannerType</p>
                    <h1>@banners[0].BannerName</h1>
                    <button class="banner-btn">SHOP NOW &rarr;</button>
                </div>
            </div>

            <div class="side-banners">
                @if (banners.Count > 1)
                {
                    <div class="top-banner" style="background-image: url('/images/banner_img/@banners[1].BannerImage');">
                        <div class="banner-content small">
                            <p>@banners[1].BannerType</p>
                            <h2>@banners[1].BannerName</h2>
                            <button class="banner-btn">BUY NOW &rarr;</button>
                        </div>
                    </div>
                }
                @if (banners.Count > 2)
                {
                    <div class="bottom-banner" style="background-image: url('/images/banner_img/@banners[2].BannerImage');">
                        <div class="banner-content small">
                            <p>@banners[2].BannerType</p>
                            <h2>@banners[2].BannerName</h2>
                            <button class="banner-btn">BUY NOW &rarr;</button>
                        </div>
                    </div>
                }
                
            </div>

        }
        
    </div>
</div>

<!-- banner section end -->
<!-- category & product section start -->

<div class="myContainer my-5">
    <div class="category-scroll-wrapper">
        <button class="cat-filter active" data-id="0">All</button>
        @foreach (var cat in Model.Categories)
        {
            <button class="cat-filter" data-id="@cat.CategoryId">@cat.CategoryName</button>
        }
        
    </div>

    
        <!-- partial product loading -->
        <div class="product-grid" id="product-container">
            <partial name="_ProductListPartial" model="@Model.Products" />
        </div>
</div>

<!-- category & product section end -->

<!-- offer section start -->
<div class="myContainer">
    <div class="offer-grid">
        @foreach (var offer in Model.Offers)
        {
            <div class="offer-card" style="background-image: url('/images/offer_img/@offer.OfferImage');">
                <div class="offer-overlay">
                    <div class="card-content">
                        <p>@offer.OfferType</p>
                        <h2>@offer.OfferName</h2>
                        <h3>SAVE $@offer.OfferPrice.ToString("F2")</h3>
                        <button class="offer-btn">BUY NOW &rarr;</button>
                    </div>
                </div>
            </div>

        }
    </div>
</div>
<!-- offer section end -->



@section Scripts {
    <script>
        $(document).ready(function () {
            $(".cat-filter").click(function () {
                
                $(".cat-filter").removeClass("active");
                $(this).addClass("active");

                var categoryId = $(this).data("id");

                
                $.ajax({
                    
                    url: '@Url.Action("GetProductsByCategory", "Customer")',
                    type: 'GET',
                    data: { id: categoryId },
                    success: function (result) {
                        
                        $("#product-container").html(result);
                    },
                    error: function () {
                        alert("Error loading products!");
                    }
                });
            });
        });
    </script>
}
