<!-- offer section start -->
<div class="myContainer">
    <div class="offer-grid">
        @foreach (var offer in Model.Offers)
        {
            <div class="offer-card" style="background-image: url('/images/offer_img/@offer.OfferImage');">
                <div class="offer-overlay">
                    <div class="card-content">
                        <p>@offer.OfferType</p>
                        <h2>@offer.OfferName</h2>
                        <h3>SAVE $@offer.OfferPrice.ToString("F2")</h3>
                        <button class="offer-btn">BUY NOW &rarr;</button>
                    </div>
                </div>
            </div>

        }
    </div>
</div>
<!-- offer section end -->

