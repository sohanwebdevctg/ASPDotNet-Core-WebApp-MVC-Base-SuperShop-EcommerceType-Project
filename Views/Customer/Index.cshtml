
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- banner section start -->

<div class="myContainer">
    <div class="banner-grid">
        <div class="main-banner" style="background-image: url('/images/banner/mainbanner.png');">
            <div class="banner-content">
                <p>PRE-ORDER NOW</p>
                <h1>SPACESITY 2</h1>
                <button class="banner-btn">PRE-ORDER NOW &rarr;</button>
            </div>
        </div>

        <div class="side-banners">
            <div class="top-banner" style="background-image: url('/images/banner/topbanner.png');">
                <div class="banner-content small">
                    <p>WEEKEND OFFER</p>
                    <h2>VIVAMUS</h2>
                    <button class="banner-btn">BUY NOW &rarr;</button>
                </div>
            </div>
            <div class="bottom-banner" style="background-image: url('/images/banner/bottombanner.png');">
                <div class="banner-content small">
                    <p>DONEC NEC 35% OFF</p>
                    <h2>PRODUCT NAME</h2>
                    <button class="banner-btn">BUY NOW &rarr;</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- banner section end -->

<!-- offer section start -->
<div class="myContainer">
    <div class="offer-grid">
        <div class="offer-card" style="background-image: url('/images/offer_img/offerimg1.png');">
            <div class="offer-overlay">
                <div class="card-content">
                    <p>WEEKEND OFFER</p>
                    <h2>FIREBALL</h2>
                    <h3>SAVE $19.99</h3>
                    <button class="offer-btn">BUY NOW &rarr;</button>
                </div>
            </div>
        </div>

        <div class="offer-card" style="background-image: url('/images/offer_img/offerimg2.png');">
            <div class="offer-overlay">
                <div class="card-content">
                    <p>AMAZING DEAL ON AN</p>
                    <h2>XBOX ONE</h2>
                    <h3>SAVE $50</h3>
                    <button class="offer-btn">BUY NOW &rarr;</button>
                </div>
            </div>
        </div>

        <div class="offer-card" style="background-image: url('/images/offer_img/offerimg3.png');">
            <div class="offer-overlay">
                <div class="card-content">
                    <p>SAVE $29.00</p>
                    <h2>GALAXY WAR</h2>
                    <h3>SAVE $30</h3>
                    <button class="offer-btn">BUY NOW &rarr;</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- offer section end -->

