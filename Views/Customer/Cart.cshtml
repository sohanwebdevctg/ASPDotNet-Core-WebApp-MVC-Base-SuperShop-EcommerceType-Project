
@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- cart start -->
<div class="user-cart-section">
    <div class="myContainer">
        <h3 class="cart-title">Cart History : 2</h3>
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Img</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Qty</th>
                        <th scope="col">Total</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td><img src="~/images/offer_img/offerimg1.png" class="cart-img"></td>
                        <td>Wireless Headphone</td>
                        <td>$150</td>
                        <td>2</td>
                        <td>$300</td>
                        <td><a class="edit-btn">Edit</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- cart end -->
