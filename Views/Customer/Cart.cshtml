
@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- cart start -->
<div class="user-cart-section">
    <div class="myContainer">
        <h3 class="section-title">Cart History</h3>
        <div class="table-container">
            <table class="responsive-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Img</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td><img src="~/images/product1.jpg" class="cart-img" alt="Product"></td>
                        <td><span>Wireless Headphone</span></td>
                        <td>$150</td>
                        <td>2</td>
                        <td>$300</td>
                        <td><a class="edit-btn">Edit</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- cart end -->
