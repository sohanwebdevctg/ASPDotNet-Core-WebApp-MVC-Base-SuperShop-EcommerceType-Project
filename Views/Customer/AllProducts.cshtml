@model IEnumerable<SuperShop.Models.Product>;
@{
    ViewData["Title"] = "AllProducts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--  allProducts section start -->

<div class="myContainer my-5">

    <!-- search section start -->
    <div class="search-section">
        <form asp-controller="Customer" asp-action="AllProducts" method="get" class="search-form" style="display: flex; gap: 10px; align-items: center;">

            <div class="input-group">
                <input type="text" name="searchName" value="@ViewBag.CurrentName" placeholder="Search Your Product" class="search-input" />
            </div>
            <div class="input-group">
                <input type="number" name="searchPrice" value="@ViewBag.CurrentPrice" placeholder="Search Your Max Price" class="search-input" />
            </div>
            <button type="submit" style="display: none;"></button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentName) || ViewBag.CurrentPrice != null)
            {
                <a href="@Url.Action("AllProducts", "Customer")" class="common-submit-btn"
               style="text-decoration: none; padding: 10px 20px; border-radius: 5px; color: white; background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">
                    See All Data
                </a>
            }
        </form>
    </div>

    <!-- search section end -->
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning text-center">
            @ViewBag.Message
        </div>
        
    }
    

    <div class="product-grid" id="product-container">

        <!-- product start -->
        @foreach (var data in Model)
        {
            <div class="product-card">
                <div class="product-img-container">
                    <img src="~/images/product_img/@data.ProductImage" alt="@data.ProductName">
                </div>

                <div class="product-body">
                    <h5 class="product-title">@data.ProductName</h5>
                    <p class="product-price">Price: $@data.ProductPrice.ToString("F2")</p>
                    <p class="product-desc">
                        <strong>ProductLimit :</strong>
                        @(data.ProductLimit < 0 ? 0 : data.ProductLimit)
                    </p>
                    <p class="product-desc">
                        @(data.ProductDescription?.Length > 30 ? data.ProductDescription.Substring(0, 30) + "..." : data.ProductDescription)
                    </p>

                    <div>
                        <a href="@Url.Action("ProductDetails", "Customer", new { id = data.ProductId })" class="cart-btn">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
        
    <!-- product end -->
    </div>

</div>

<!-- allProducts section end -->


