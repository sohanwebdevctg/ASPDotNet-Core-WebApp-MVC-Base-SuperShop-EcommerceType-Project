
@{
    ViewData["Title"] = "CreateGender";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="myContainer">
    <div class="common-form-wrapper">
        <form class="master-form">
            <div>
                <h2 class="form-title">Create Gender</h2>
            </div>
            <div class="form-group">
                <input type="text" placeholder="Enter Name" class="common-input" />
            </div>

            <div class="form-group">
                <input type="email" placeholder="Enter Email" class="common-input" />
            </div>

            <div class="form-group">
                <input type="text" placeholder="Enter Phone" class="common-input" />
            </div>

            <div class="form-group">
                <select class="common-input">
                    <option value="" disabled selected>Select Option</option>
                    <option value="a">Option A</option>
                    <option value="b">Option B</option>
                </select>
            </div>

            <div class="form-group">
                <div class="image-preview-container">
                    <img src="~/images/placeholder.png" alt="Preview" class="form-img-preview" />
                </div>
            </div>

            <div class="form-group">
                <textarea placeholder="Enter Description" class="common-input text-area-input"></textarea>
            </div>

            <div class="form-group">
                <button type="submit" class="common-submit-btn">SUBMIT DATA</button>
            </div>
        </form>
    </div>
</div>

