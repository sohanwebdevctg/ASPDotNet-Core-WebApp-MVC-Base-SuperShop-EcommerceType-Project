@model IEnumerable<SuperShop.Models.Role>;
@{
    ViewData["Title"] = "AllRole";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- all role start -->
<div class="table-content-area">
    <div class="myContainer">
        <h3 class="table-title">Total : @Model.Count()</h3>
        <div class="table-wrapper">
            <div class="table-container">
                <table class="table-content">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>RoleName</th>
                            <th>TotlaUser</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.Count() > 0){
                            int serialNo = 1;
                            @foreach(var data in Model){
                                <tr>
                                    <td>@(serialNo++)</td>
                                    <td>@data.RoleName</td>
                                    <td>@(data.Users != null ? data.Users.Count() : 0)</td>
                                    <td class="btn-wrapper">
                                        <a href="#" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Edit</a>
                                        <a href="#" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #dc3545 100%);">Delete</a>
                                    </td>
                                </tr>
                            }
                        }else{
                            <tr>
                                <td colspan="4" class="text-danger text-center">@ViewBag.message</td>
                            </tr>
                        }
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- all role end -->

