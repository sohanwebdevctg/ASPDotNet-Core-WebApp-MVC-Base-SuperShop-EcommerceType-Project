
@{
    ViewData["Title"] = "CreateCity";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- create city start -->
<div class="myContainer">
    <div class="common-form-wrapper">
        <form class="master-form">
            <div>
                <h2 class="form-title">Create City</h2>
            </div>
            <div class="form-group">
                <input type="text" placeholder="Enter Name" class="common-input" />
            </div>
            <div class="form-group common-submit-wrapper">
                <button type="submit" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">SUBMIT DATA</button>
                <a href="@Url.Action("AllCity", "Admin")" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">ALL CITY</a>
            </div>
        </form>
    </div>
</div>

<!-- create city end -->

