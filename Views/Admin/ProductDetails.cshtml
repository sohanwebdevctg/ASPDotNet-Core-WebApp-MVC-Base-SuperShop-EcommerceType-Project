@model SuperShop.Models.Product;
@{
    ViewData["Title"] = "ProductDetails";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- product details start -->
<div class="myContainer">
    <div class="userprofile-section">
        <div class="userprofile-wrapper">
            <div class="userprofile-img">
                <img src="@Url.Content(Model.ProductImage != null ? "~/images/product_img/"+Model.ProductImage : "~/images/product_img/no-user.png")" alt="User Name" asp-append-version=true>
            </div>

            <div class="userprofile-content">
                <h4 class="userprofile-title">Product Details</h4>
                <h3 class="userprofiel-name">@(Model.ProductName != null ? Model.ProductName : "No Data")</h3>
                <div class="userprofile-role">Role: @(Model.Category?.CategoryName != null ? Model.Category?.CategoryName : "No Data")</div>
                <p class="userprofile-desc">Price: <strong>$@Model.ProductPrice.ToString("F2")</strong></p>
                <p class="userprofile-desc">Stock Limit: @Model.ProductLimit</p>

                <p class="userprofile-desc" style="margin-top: 10px;">
                    <strong>Description:</strong><br />
                    @Model.ProductDescription
                </p>
                <div class="userprofile-actions">
                    <a href="@Url.Action("EditProduct", "Admin", new {id = Model.ProductId})" class="buttons" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">Edit</a>
                    <a href="@Url.Action("AllProduct", "Admin")" class="buttons" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- product details end -->
