@model SuperShop.Models.City;
@{
    ViewData["Title"] = "EditCity";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- edit city start -->
<div class="myContainer">
    <div class="common-form-wrapper">
        <form asp-controller="Admin" asp-action="UpdateCity" method="post" class="master-form">
            <div>
                <h2 class="form-title">Update City</h2>
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="CityId" />
                <input asp-for="CityName" type="text" placeholder="Update Your City Name" class="common-input" />
                <span asp-validation-for="CityName" class="text-danger" style="font-size: 15px;"></span>
            </div>
            <div class="form-group common-submit-wrapper">
                <button type="submit" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">UPDATE DATA</button>
                <a href="@Url.Action("AllCity", "Admin")" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">ALL CITY</a>
            </div>
        </form>
    </div>
</div>

<!-- edit city end -->