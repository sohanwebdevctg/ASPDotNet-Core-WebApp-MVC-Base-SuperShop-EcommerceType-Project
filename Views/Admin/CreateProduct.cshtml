
@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- create product start -->

<div class="myContainer">
    <div class="common-form-wrapper">
        <form class="master-form">
            <div>
                <h2 class="form-title">Create Product</h2>
            </div>
            <div class="form-group">
                <input type="text" placeholder="Enter Name" class="common-input" />
            </div>
            <div class="form-group">
                <input type="text" placeholder="Enter Name" class="common-input" />
            </div>
            <div class="form-group">
                <input type="text" placeholder="Enter Name" class="common-input" />
            </div>
            <div class="form-group">
                <input type="file" placeholder="Enter Name" class="common-input" style="background: white; width: 100%;" />
            </div>
            <div class="form-group">
                <textarea placeholder="Enter Description" class="common-input text-area-input"></textarea>
            </div>
            <div class="form-group">
                <select class="common-input">
                    <option value="" disabled selected>Select Option</option>
                    <option value="a">Option A</option>
                    <option value="b">Option B</option>
                </select>
            </div>

            <div class="form-group common-submit-wrapper">
                <button type="submit" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">SUBMIT DATA</button>
                <a href="@Url.Action("AllProduct", "Admin")" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">ALL PRODUCT</a>
            </div>
        </form>
    </div>
</div>
<!-- create product end -->

