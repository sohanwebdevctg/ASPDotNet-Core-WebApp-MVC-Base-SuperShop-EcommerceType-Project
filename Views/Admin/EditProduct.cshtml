@model SuperShop.ViewModels.ProductVM;
@{
    ViewData["Title"] = "EditProduct";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- edit product start -->

<div class="myContainer">
    <div class="common-form-wrapper">
        <form asp-controller="Admin" asp-action="UpdateProduct" method="post" enctype="multipart/form-data" class="master-form">
            <input type="hidden" asp-for="ProductData.ProductId" />
            <input type="hidden" asp-for="ProductData.ProductImage" />
            <div>
                <h2 class="form-title">Update Product</h2>
            </div>
            <div class="form-group">
                <input type="text" asp-for="ProductData.ProductName" placeholder="Enter Product Name" class="common-input" />
                <span asp-validation-for="ProductData.ProductName" class="text-danger" style="font-size: 12px;"></span>
            </div>
            <div class="form-group">
                <input type="number" asp-for="ProductData.ProductPrice" value="@Model.ProductData.ProductPrice.ToString("0.00")" step="0.01" placeholder="Enter Product Price" class="common-input" />
                <span asp-validation-for="ProductData.ProductPrice" class="text-danger" style="font-size: 12px;"></span>

            </div>
            <div class="form-group">
                <input type="number" asp-for="ProductData.ProductLimit" placeholder="Enter Product Limit" class="common-input" />
                <span asp-validation-for="ProductData.ProductLimit" class="text-danger" style="font-size: 12px;"></span>

            </div>
            <div class="form-group">
                <label class="form-label">NewImage</label>
                <input type="file" name="imageFile" placeholder="Enter Product Image" class="common-input" style="background: white; width: 100%;" />
            </div>
            <div class="form-group">
                <label class="form-label">PreviousImage</label>
                <img style="width: 80px; height: 80px;" asp-append-version=true src="@Url.Content(Model.ProductData.ProductImage != null ? "~/images/product_img/"+Model.ProductData.ProductImage : "~/images/product_img/no_image.png")" />
            </div>
            <div class="form-group">

                <textarea asp-for="ProductData.ProductDescription" placeholder="Enter Product Description" class="common-input text-area-input"></textarea>
                <span asp-validation-for="ProductData.ProductDescription" class="text-danger" style="font-size: 12px;"></span>

            </div>
            <div class="form-group">
                <select asp-for="ProductData.CategoryId" asp-items="Model.CategoryList" class="common-input">
                    <option value="" disabled selected>Select Option</option>
                </select>
                <span asp-validation-for="ProductData.CategoryId" class="text-danger" style="font-size: 12px;"></span>

            </div>

            <div class="form-group common-submit-wrapper">
                <button type="submit" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">UPDATE DATA</button>
                <a href="@Url.Action("AllProduct", "Admin")" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">ALL PRODUCT</a>
            </div>
        </form>
    </div>
</div>
<!-- edit product end -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }

