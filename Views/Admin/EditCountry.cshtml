@model SuperShop.Models.Country;
@{
    ViewData["Title"] = "EditCountry";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- create country start -->
<div class="myContainer">
    <div class="common-form-wrapper">
        <form asp-controller="Admin" asp-action="UpdateCountry" method="post" class="master-form">
            <div>
                <h2 class="form-title">Update Country</h2>
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="CountryId" />
                <input asp-for="CountryName" type="text" placeholder="Update Your Country Name" class="common-input" />
                <span asp-validation-for="CountryName" class="text-danger" style="font-size: 15px;"></span>
            </div>
            <div class="form-group common-submit-wrapper">
                <button type="submit" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">UPDATE DATA</button>
                <a href="@Url.Action("AllCountry", "Admin")" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">ALL COUNTRY</a>
            </div>
        </form>
    </div>
</div>

<!-- create country end -->