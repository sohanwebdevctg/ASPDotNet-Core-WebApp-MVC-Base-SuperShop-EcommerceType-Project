@model IEnumerable<SuperShop.Models.Banner>;
@{
    ViewData["Title"] = "AllBanner";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- all banner start -->
<div class="table-content-area">
    <div class="myContainer">

        @if (TempData["Success"] != null)
        {
            <div class="alert" style="color: green; font-weight: bold; margin-bottom: 10px;">
                @TempData["Success"]
            </div>
        }
        <h3 class="table-title">Total : @Model.Count()</h3>
        <div class="table-wrapper">
            <div class="table-container">

                <table class="table-content">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>BannerImage</th>
                            <th>BannerType</th>
                            <th>BannerName</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.Count() > 0)
                        {
                            int serialNo = 1;
                            @foreach (var data in Model)
                            {
                                <tr>
                                    <td>@(serialNo++)</td>
                                    <td>
                                        <img style="width: 50px; height: 50px;" asp-append-version=true src="@Url.Content(data.BannerImage != null ? "~/images/banner_img/"+data.BannerImage : "~/images/banner_img/no_image.png")" />
                                    </td>
                                    <td>@data.BannerType</td>
                                    <td>@data.BannerName</td>
                                    <td>@data.CreatedAt</td>
                                    <td class="btn-wrapper">
                                        <a href="@Url.Action("EditBanner", "Admin", new { id = data.BannerId})" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Edit</a>
                                        <form asp-controller="Admin" asp-action="DeleteBanner" method="post">
                                            <input type="hidden" name="id" value="@data.BannerId">
                                            <button type="submit" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #dc3545 100%);">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }

                        }
                        else
                        {

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- all banner end -->

