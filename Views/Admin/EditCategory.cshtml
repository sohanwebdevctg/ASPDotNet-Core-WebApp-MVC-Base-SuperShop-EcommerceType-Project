@model SuperShop.Models.Category;
@{
    ViewData["Title"] = "EditCategory";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- edit category start -->
<div class="myContainer">
    <div class="common-form-wrapper">
        <form asp-controller="Admin" asp-action="UpdateCategory" method="post" class="master-form">
            <input type="hidden" asp-for="CategoryId"/>
            <div>
                <h2 class="form-title">Update Category</h2>
            </div>
            <div class="form-group">
                <input asp-for="CategoryName" type="text" placeholder="Enter Category Name" class="common-input" />
                <span asp-validation-for="CategoryName" class="text-danger" style="font-size: 12px;"></span>
            </div>
            <div class="form-group common-submit-wrapper">
                <button type="submit" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">UPDATE DATA</button>
                <a href="@Url.Action("AllCategory", "Admin")" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">ALL CATEGORY</a>
            </div>
        </form>
    </div>
</div>

<!-- edit category end -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }

