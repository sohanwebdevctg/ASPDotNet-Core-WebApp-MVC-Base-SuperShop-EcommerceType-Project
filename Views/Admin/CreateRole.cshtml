@model SuperShop.Models.Role;
@{
    ViewData["Title"] = "CreateRole";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- create role start -->
<div class="myContainer">
    <div class="common-form-wrapper">
        <form asp-controller="Admin" asp-action="CreateRole" method="post" class="master-form">
            <div>
                <h2 class="form-title">Create Role</h2>
            </div>
            <div class="form-group">
                <input asp-for="RoleName" type="text" placeholder="Enter Your Role Name" class="common-input" />
                <span asp-validation-for="RoleName" class="text-danger" style="font-size: 15px;"></span>
            </div>
            <div class="form-group common-submit-wrapper">
                <button type="submit" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">SUBMIT DATA</button>
                <a href="@Url.Action("AllRole", "Admin")" class="common-submit-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">ALL ROLE</a>
            </div>
        </form>
    </div>
</div>

<!-- create role end -->

