@model IEnumerable<SuperShop.Models.Country>;
@{
    ViewData["Title"] = "AllCountry";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- all country start -->
<div class="table-content-area">
    <div class="myContainer">
        @if (TempData["Error"] != null)
        {
            <div class="alert" style="color: red; font-weight: bold; margin-bottom: 10px;">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert" style="color: green; font-weight: bold; margin-bottom: 10px;">
                @TempData["Success"]
            </div>
        }
        <h3 class="table-title">Total : @Model.Count()</h3>
        <div class="table-wrapper">
            <div class="table-container">
                <table class="table-content">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>CountryName</th>
                            <th>TotalUser</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                        @if (Model.Count() > 0)
                        {
                            int serialNo = 1;
                            @foreach (var data in Model)
                            {
                                <tr>
                                    <td>@(serialNo++)</td>
                                    <td>@data.CountryName</td>
                                    <td>@(data.Users != null ? data.Users.Count() : 0)</td>
                                    <td class="btn-wrapper">
                                        <a href="@Url.Action("EditCountry", "Admin", new {id = data.CountryId})" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Edit</a>
                                        <form asp-controller="Admin" asp-action="DeleteCountry" method="post">
                                            <input type="hidden" name="id" value="@data.CountryId">
                                            <button type="submit" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #dc3545 100%);">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-danger text-center">@ViewBag.message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- all country end -->

