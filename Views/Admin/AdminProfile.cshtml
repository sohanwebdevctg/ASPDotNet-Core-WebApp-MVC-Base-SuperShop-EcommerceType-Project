@model SuperShop.Models.User;
@{
    ViewData["Title"] = "AdminProfile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}


<!-- admin profile start -->
<div class="myContainer">
    <div class="adminprofile-section">
        <div class="adminprofile-wrapper">
            <div class="adminprofile-img">
                <img src="@Url.Content(Model.UserImage != null ? "~/images/user_img/"+Model.UserImage : "~/images/user_img/no-user.png")" alt="admin Name" asp-append-version=true>
            </div>

            <div class="adminprofile-content">
                <h4 class="adminprofile-title">Admin Profile</h4>
                <h3 class="adminprofiel-name">@(Model.UserName != null ? Model.UserName : "No Data")</h3>
                <div class="adminprofile-role">Role: @(Model.Role?.RoleName != null ? Model.Role?.RoleName : "No Data")</div>
                <p class="adminprofile-desc">Email: @(Model.UserEmail != null ? Model.UserEmail : "No Data")</p>
                <p class="adminprofile-desc">Gender: @(Model.Gender?.GenderName != null ? Model.Gender?.GenderName : "No Data")</p>
                <p class="adminprofile-desc">
                    Address: @(Model.UserAddress != null ? Model.UserAddress : "No Data"),
                    @(Model.City?.CityName != null ? Model.City?.CityName : "No City"),
                    @(Model.Country?.CountryName != null ? Model.Country?.CountryName : "No Country")
                </p>
                <div class="adminprofile-actions">
                    <a href="@Url.Action("UpdateUser", "Admin", new {id = Model.UserId})" class="buttons" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">Edit</a>
                    <a href="@Url.Action("Index", "Admin")" class="buttons" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- admin profile end -->

