
@{
    ViewData["Title"] = "AdminProfile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}


<!-- admin profile start -->
<div class="myContainer">
    <div class="adminprofile-section">
        <div class="adminprofile-wrapper">
            <div class="adminprofile-img">
                <img src="~/images/offer_img/offerimg1.png" alt="admin Name">
            </div>

            <div class="adminprofile-content">
                <h4 class="adminprofile-title">Admin Profile</h4>
                <h3 class="adminprofiel-name">John Randy</h3>
                <div class="adminprofile-role">Role: Admin</div>
                <p class="adminprofile-desc">Email: johnrandy@gmail.com</p>
                <div class="adminprofile-actions">
                    <a href="@Url.Action("UpdateUser", "Admin")" class="buttons" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">Edit</a>
                    <a href="@Url.Action("Index", "Admin")" class="buttons" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- admin profile end -->

