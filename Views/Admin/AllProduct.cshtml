@model IEnumerable<SuperShop.Models.Product>;
@{
    ViewData["Title"] = "AllProduct";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- all product start -->
<div class="table-content-area">
    <div class="myContainer">
        @if (TempData["Success"] != null)
        {
            <div class="alert" style="color: green; font-weight: bold; margin-bottom: 10px;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert" style="color: red; font-weight: bold; margin-bottom: 10px;">
                @TempData["Error"]
            </div>
        }
        <h3 class="table-title">Total : @Model.Count()</h3>

        <div class="table-wrapper">
            <div class="table-container">
                <table class="table-content">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ProductImg</th>
                            <th>ProductName</th>
                            <th>ProductPrice</th>
                            <th>ProductLimit</th>
                            <th>ProductDescription</th>
                            <th>Category</th>
                            <th>Order</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count() > 0)
                        {

                            int serialNo = 1;
                            @foreach (var data in Model)
                            {
                                <tr>
                                    <td>@(serialNo++)</td>
                                    <td><img asp-append-version=true src="@Url.Content(data.ProductImage != null ? "~/images/product_img/"+data.ProductImage : "~/images/product_img/no_image.png")" class="table-img"></td>
                                    <td>@data.ProductName</td>
                                    <td>$@data.ProductPrice.ToString("F2")</td>
                                    <td>@data.ProductLimit.ToString("0")</td>
                                    <td>
                                        @if (data.ProductDescription != null && data.ProductDescription.Length > 15)
                                        {
                                            @data.ProductDescription.Substring(0, 15)

                                            <span>...</span>
                                        }
                                        else
                                        {
                                            @data.ProductDescription
                                        }
                                    </td>
                                    <td>@data.Category?.CategoryName</td>
                                    <td>0</td>
                                    <td class="btn-wrapper">
                                        <a href="@Url.Action("ProductDetails", "Admin", new {id = data.ProductId})" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #28a745 100%);">Details</a>
                                        <a href="@Url.Action("EditProduct", "Admin", new {id = data.ProductId})" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #ED4264 100%);">Edit</a>
                                        <a href="#" class="table-btn" style="background: linear-gradient(135deg, #FFEDBC 0%, #dc3545 100%);">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-danger text-center">@ViewBag.message</td>
                            </tr>
                        }
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- all product end -->

