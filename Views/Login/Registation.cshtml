@model SuperShop.Models.User;

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuperShop.styles.css" asp-append-version="true" />
</head>
<body class="login-body">
    <!--<div asp-validation-summary="All" class="text-danger"></div>-->
    <!-- registation start -->
    <div class="myContainer">
        <div class="registation-wrapper">
            <div class="registation-container">
                <h3>Registation</h3>
                <form asp-controller="Login" asp-action="Registation" method="Post">
                    <div class="input-group-custom">
                        <input asp-for="UserName" type="text" placeholder="Enter Your Name" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="input-group-custom">
                        <input asp-for="UserEmail" type="email" placeholder="Enter Your Email" />
                        <span asp-validation-for="UserEmail" class="text-danger"></span>
                    </div>
                    <div class="input-group-custom">
                        <input asp-for="UserPassword" type="password" placeholder="Enter Your Password" />
                        <span asp-validation-for="UserPassword" class="text-danger"></span>
                    </div>
                    <button type="submit">REGISTER</button>
                </form>
                <div class="divider">OR</div>

                <button class="google-btn">
                    <img src="~/images/logo//googlelogo.png">
                    <p>Continue with Google</p>
                </button>
                <p class="login-link">
                    If You have an account? <a href="@Url.Action("Index","Login")">Login</a>
                </p>
            </div>
        </div>
    </div>
    <!-- registation end -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

